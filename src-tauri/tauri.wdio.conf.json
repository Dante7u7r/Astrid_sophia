{
  "identifier": "com.biaani.desktop.wdio",
  "build": {
    "beforeBuildCommand": "npm run build:e2e"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "default",
        {
          "identifier": "wdio",
          "description": "Instrumentación disponible únicamente en compilaciones E2E",
          "windows": ["main"],
          "permissions": ["wdio:default"]
        }
      ]
    }
  },
  "bundle": {
    "active": false
  }
}
